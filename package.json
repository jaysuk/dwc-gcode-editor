{
  "name": "dwc-gcode-editor",
  "version": "0.1.0",
  "type": "module",
  "description": "Custom G-code editor core for the DuetWebControl plugin family: a CodeMirror-6-based, virtualised, huge-file-capable editor driven by dwc-gcode-core's tokeniser, dictionary and diagnostics. Framework-free — no Vue, Vuetify or DWC imports; a thin Vue wrapper per consuming plugin renders it.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/jaysuk/dwc-gcode-editor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaysuk/dwc-gcode-editor.git"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "import": "./dist/language.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./completion": {
      "types": "./dist/completion.d.ts",
      "import": "./dist/completion.js"
    },
    "./docBuilder": {
      "types": "./dist/docBuilder.d.ts",
      "import": "./dist/docBuilder.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.19.0",
    "@codemirror/commands": "^6.9.1",
    "@codemirror/language": "^6.11.4",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.1",
    "dwc-gcode-core": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*",
        "dist/index.d.ts"
      ]
    }
  }
}
